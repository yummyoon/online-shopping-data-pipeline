# =======================================================
#         데이터 파이프라인 프로젝트 전체 환경변수
# =======================================================

# -------------------- MinIO (Object Storage) 설정 --------------------
# Docker 내부 컨테이너 간 통신 시에는 서비스 이름(minio)을 호스트로 사용합니다.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_RAW_DATA_BUCKET=raw-logs

# -------------------- 데이터 웨어하우스 (PostgreSQL) 설정 --------------------
# 'DW_'(Data Warehouse) 접두사를 붙여 Airflow DB와 명확히 구분합니다.
DW_POSTGRES_DB=analytics_db
DW_POSTGRES_USER=pipeline_user # 기존 airflow 유저와 겹치지 않게 변경하는 것을 추천
DW_POSTGRES_PASSWORD=pipeline_password

# -------------------- 데이터 생성 스크립트 설정 --------------------
NUM_DAYS_TO_GENERATE=10
LOGS_PER_DAY=100000

# =======================================================
#         Airflow 통합을 위해 추가된 환경변수
# =======================================================

# -------------------- Airflow 메타데이터 DB (PostgreSQL) 설정 --------------------
# Airflow가 자신의 정보를 저장하기 위해 사용하는 별도의 DB 설정입니다.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PORT=5432

# -------------------- Airflow Web UI 로그인 계정 설정 --------------------
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# -------------------- Airflow 컨테이너 기본 설정 --------------------
# Airflow 컨테이너 내에서 생성되는 파일의 소유자 ID 설정 (권한 문제 방지)
# Linux/macOS: 터미널에서 echo "AIRFLOW_UID=$(id -u)" >> .env 실행 권장
AIRFLOW_UID=50000

# Airflow 컨테이너에 자동으로 설치할 추가 파이썬 라이브러리
# 띄어쓰기로 구분하여 패키지를 나열합니다.
_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-apache-spark==4.1.1 apache-airflow-providers-amazon==8.5.0 minio python-dotenv psycopg2-binary Faker